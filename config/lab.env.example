# Copy to config/lab.env; see docs/configuration.md for every value.
# Azure/Fabric context
AZ_SUBSCRIPTION_ID='REPLACE_WITH_SUBSCRIPTION_ID'
AZ_TENANT_ID='REPLACE_WITH_TENANT_ID'
FABRIC_WORKSPACE_ID='REPLACE_WITH_FABRIC_WORKSPACE_ID'
FABRIC_EVENTHOUSE_NAME=fabric-kafka-avro-apicurio-kusto-eh
FABRIC_DATABASE_NAME=fabric_kafka_avro_poc_db

# Script 03 fills these; otherwise copy the Database details URIs.
FABRIC_QUERY_URI='REPLACE_WITH_FABRIC_QUERY_URI'
FABRIC_INGESTION_URI='REPLACE_WITH_FABRIC_INGESTION_URI'

# Connector auth (dedicated Entra app/service principal)
KUSTO_APP_ID='REPLACE_WITH_APPLICATION_CLIENT_ID'
KUSTO_APP_SECRET='REPLACE_WITH_CLIENT_SECRET_VALUE'
KUSTO_AUTHORITY_TENANT_ID='REPLACE_WITH_APPLICATION_TENANT_ID'

# Target table/mapping
FABRIC_TABLE_NAME=PocSensorEvents
FABRIC_MAPPING_NAME=PocSensorEventsJsonMapping

# Connector name/topic
CONNECTOR_NAME=fabric-kusto-sink-poc
KAFKA_TOPIC=poc.sensor.events
